<Window x:Class="Linkast.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Linkast" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/linkast.ico">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/linkast-logo.png" Width="96" Height="96" Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Linkast logo" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProductText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Lightweight, local-only live streaming for Windows." Style="{StaticResource Hint}" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Margin="0,18,0,0">
            Copyright (C) Linkast contributors.
            <LineBreak /><LineBreak />
            Linkast is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as
            published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
            <LineBreak /><LineBreak />
            Linkast is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of
            MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
        </TextBlock>

        <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" Style="{StaticResource Hint}"
                   Text="Linkast includes FFmpeg (GPL), the RobustVideoMatting model (GPL) and other open-source components. Their licenses and the complete source of the bundled FFmpeg are listed in the third-party notices." />

        <WrapPanel Margin="0,18,0,0">
            <Button Content="License (GPL)" Click="OnLicense" Margin="0,0,8,8" />
            <Button Content="Third-party notices" Click="OnNotices" Margin="0,0,8,8" />
            <Button Content="FFmpeg build and source" Click="OnFfmpeg" Margin="0,0,8,8" />
            <Button x:Name="SourceButton" Content="Source code" Click="OnSource" Margin="0,0,8,8" />
        </WrapPanel>
        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Padding="20,4" Margin="0,8,0,0" />
    </StackPanel>
</Window>

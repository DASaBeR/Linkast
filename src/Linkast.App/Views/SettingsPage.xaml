<UserControl x:Class="Linkast.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Linkast.App.ViewModels"
             xmlns:settings="clr-namespace:Linkast.Core.Settings;assembly=Linkast.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,22" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Linkast.Text.PageTitle}" />
            <TextBlock Text="Appearance, updates, hotkeys, importing from OBS and diagnostics." Style="{StaticResource Linkast.Text.Hint}" FontSize="12" Margin="0,2,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Linkast.Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource Linkast.Card.Title}" />
                            <ListBox Style="{StaticResource Linkast.Choice}" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                     AutomationProperties.Name="Appearance">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Linkast.Choice.Item}">
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="Padding" Value="8" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThemeOption}">
                                        <StackPanel AutomationProperties.Name="{Binding Label}">
                                            <!-- A miniature window: rail on the left, page on the right. -->
                                            <Border x:Name="Swatch" Height="54" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Linkast.BorderSubtle}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Rail" Background="#FF11142A" CornerRadius="5,0,0,5" />
                                                    <Border x:Name="Page" Grid.Column="1" Background="#FF0B0D1B" CornerRadius="0,5,5,0" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,2" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Theme}" Value="{x:Static settings:AppTheme.Light}">
                                                <Setter TargetName="Rail" Property="Background" Value="#FFFFFFFF" />
                                                <Setter TargetName="Page" Property="Background" Value="#FFF4F6FC" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Theme}" Value="{x:Static settings:AppTheme.System}">
                                                <Setter TargetName="Page" Property="Background" Value="#FFF4F6FC" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Linkast.Card}">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource Linkast.Card.Title}" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Linkast.Button.Primary}" Command="{Binding InstallUpdateCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Downloads the new version and restarts Linkast. Not available while you are live.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                            <AccessText Text="_Update now" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding CheckForUpdatesCommand}" Margin="8,0,0,0"
                                            ToolTip="Looks for a newer Linkast release on GitHub">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                            <AccessText Text="_Check for updates" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{Binding UpdateAvailable, Converter={x:Static vm:Converters.UpdateBrush}}"
                                               FontWeight="{Binding UpdateAvailable, Converter={x:Static vm:Converters.BoldWhenTrue}}"
                                               AutomationProperties.Name="Update status" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,12,0,0"
                                       Text="Linkast checks once when it starts and when you press Check for updates. It never installs anything until you press Update now." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Linkast.Card}" DataContext="{Binding Hotkeys}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Content="Reset to defaults"
                                        Command="{Binding ResetDefaultsCommand}" VerticalAlignment="Top" />
                                <TextBlock Text="Hotkeys" Style="{StaticResource Linkast.Card.Title}" />
                            </DockPanel>
                            <CheckBox Content="Use hotkeys, even while a game or another app is in front" IsChecked="{Binding Enabled}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding Enabled}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HotkeyRowViewModel}">
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Icon}" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="No hotkey for this action"
                                                        AutomationProperties.Name="{Binding Label, StringFormat='Remove the hotkey for {0}'}">
                                                    <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE711;" FontSize="11" />
                                                </Button>
                                                <TextBox DockPanel.Dock="Right" Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                         Text="{Binding Text, Mode=OneWay}" HorizontalContentAlignment="Center"
                                                         PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxFocus" Tag="{Binding}"
                                                         ToolTip="Click here, then press the keys you want, for example Ctrl+Alt+L"
                                                         AutomationProperties.Name="{Binding Label, StringFormat='Hotkey for {0}'}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource Linkast.Warning}" FontSize="12" Margin="0,4,0,0"
                                                       Visibility="{Binding Problem, Converter={x:Static vm:Converters.NotNullToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,4,0,0"
                                       Text="Click a box and press the new keys. Use Ctrl, Alt or Win with a letter, number or F key, so the hotkey never gets in the way of typing in a game." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Linkast.Card}" DataContext="{Binding ObsImport}" IsEnabled="{Binding DataContext.CanEditSettings, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel>
                            <TextBlock Text="Import from OBS" Style="{StaticResource Linkast.Card.Title}" />
                            <TextBlock Style="{StaticResource Linkast.Text.Body}" Margin="0,0,0,10"
                                       Text="Bring over your stream server and key, quality, what you capture, cameras, alerts and pictures from OBS Studio. OBS itself is not changed." />
                            <WrapPanel>
                                <Button Style="{StaticResource Linkast.Button.Primary}" Command="{Binding FindCommand}" Margin="0,0,8,0" AutomationProperties.Name="Find OBS settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE721;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Find OBS settings" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding ChooseFolderCommand}" Content="Choose folder…"
                                        ToolTip="For a portable OBS or a copied settings folder" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding Message, Converter={x:Static vm:Converters.NotNullToVisibility}}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Visibility="{Binding HasFound, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ObsImportItem}">
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Linkast.TextSecondary}" FontSize="12" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Margin="0,2,0,0" Visibility="{Binding Skipped.Count, Converter={x:Static vm:Converters.NonZeroToVisibility}}">
                                    <Expander.Header>
                                        <TextBlock><Run Text="Not imported (" /><Run Text="{Binding Skipped.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Skipped}" Margin="0,4,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource Linkast.TextSecondary}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <Button Style="{StaticResource Linkast.Button.Primary}" Command="{Binding ImportCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Import ticked settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Import ticked settings" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Linkast.Card}">
                        <StackPanel>
                            <TextBlock Text="Diagnostics" Style="{StaticResource Linkast.Card.Title}" />
                            <TextBlock Text="FFmpeg in use" Style="{StaticResource Linkast.Text.FieldLabel}" />
                            <TextBlock Text="{Binding FfmpegDescription}" TextWrapping="Wrap" FontFamily="{DynamicResource Linkast.Font.Mono}" FontSize="11"
                                       Foreground="{DynamicResource Linkast.TextSecondary}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Copy diagnostics" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding OpenLogFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Open logs" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,10,0,0"
                                       Text="Diagnostics leave out your stream key and are only copied to your clipboard." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Linkast.Card}">
                        <StackPanel>
                            <TextBlock Text="Privacy" Style="{StaticResource Linkast.Card.Title}" />
                            <TextBlock Style="{StaticResource Linkast.Text.Body}"
                                       Text="No account, no cloud, no telemetry. Your stream goes straight from this PC to the server you choose. Besides the update check on GitHub, Linkast only connects to the web overlays you add, which load their own pages." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

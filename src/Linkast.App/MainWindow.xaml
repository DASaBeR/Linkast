<Window x:Class="Linkast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Linkast.App.ViewModels"
        xmlns:views="clr-namespace:Linkast.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Linkast" Width="1280" Height="820" MinWidth="960" MinHeight="620"
        Icon="pack://application:,,,/Assets/linkast.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Linkast.AppBg}" Foreground="{DynamicResource Linkast.TextPrimary}"
        FontFamily="{DynamicResource Linkast.Font.Body}" FontSize="{DynamicResource Linkast.FontSize.Body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding StartCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Linkast.Surface1}" BorderBrush="{DynamicResource Linkast.BorderSubtle}"
                BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Linkast.StatusPill.Warning}" Margin="0,0,10,0" ToolTip="Viewers see the Be right back screen"
                            Visibility="{Binding Overlays.IsAway, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE769;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="BE RIGHT BACK" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Linkast.StatusPill.Error}" Margin="0,0,10,0" ToolTip="Your microphone is muted in the stream"
                            Visibility="{Binding ShowMicrophoneMuted, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE74F;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="MIC MUTED" />
                        </StackPanel>
                    </Border>
                    <!-- While streaming, the state and timer stay visible on every page. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <Border Style="{Binding State, Converter={x:Static vm:Converters.StateToPillStyle}}">
                            <TextBlock Text="{Binding PillText}" />
                        </Border>
                        <TextBlock Text="{Binding ElapsedText}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Elapsed time" />
                    </StackPanel>
                    <Border Style="{StaticResource Linkast.StatusPill}" ToolTip="No account, no cloud, no telemetry">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE72E;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="LOCAL ONLY" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The app artwork, shown with rounded corners (display only; the file is used as supplied). -->
                    <Image Source="pack://application:,,,/Assets/linkast-256.png" Width="32" Height="32" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Linkast logo">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7" />
                        </Image.Clip>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Linkast" FontFamily="{DynamicResource Linkast.Font.Display}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="STREAM  ·  CONNECT  ·  CREATE" FontSize="9.5" Foreground="{DynamicResource Linkast.TextTertiary}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Navigation rail ===== -->
        <Border Grid.Row="1" Background="{DynamicResource Linkast.Surface1}" BorderBrush="{DynamicResource Linkast.BorderSubtle}" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,12" AutomationProperties.Name="Main navigation">
                <RadioButton x:Name="NavStream" Style="{StaticResource Linkast.Nav.Item}" GroupName="Nav" Tag="&#xE93E;" Content="_Stream"
                             IsChecked="True" Checked="OnPageChanged" ToolTip="Stream (Alt+S)" AutomationProperties.Name="Stream" />
                <RadioButton x:Name="NavWebcam" Style="{StaticResource Linkast.Nav.Item}" GroupName="Nav" Tag="&#xE960;" Content="_Webcam"
                             Checked="OnPageChanged" ToolTip="Webcam Studio (Alt+W)" AutomationProperties.Name="Webcam Studio" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource Linkast.Nav.Item}" GroupName="Nav" Tag="&#xE713;" Content="Se_ttings"
                             Checked="OnPageChanged" ToolTip="Settings (Alt+T)" AutomationProperties.Name="Settings" />
                <RadioButton x:Name="NavAbout" Style="{StaticResource Linkast.Nav.Item}" GroupName="Nav" Tag="&#xE946;" Content="A_bout"
                             Checked="OnPageChanged" ToolTip="About (Alt+B)" AutomationProperties.Name="About" />
            </StackPanel>
        </Border>

        <!-- ===== Pages ===== -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- ===== Stream page ===== -->
            <Grid Visibility="{Binding IsChecked, ElementName=NavStream, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="460" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,18,14,22">
                        <TextBlock Text="Stream" Style="{StaticResource Linkast.Text.PageTitle}" />
                        <TextBlock Text="Preview your output, choose your network, then go live." Style="{StaticResource Linkast.Text.Hint}"
                                   FontSize="12" Margin="0,2,0,16" />

                        <!-- Output preview: the same scene the stream draws, read-only here. -->
                        <Border Style="{StaticResource Linkast.Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Click="OnEditLayout"
                                            ToolTip="Move and resize cameras in Webcam Studio">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Edit layout" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Output preview" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                        <Border Style="{StaticResource Linkast.StatusPill}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Webcam.CanvasDescription}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <Border CornerRadius="{StaticResource Linkast.Radius.Preview}" BorderBrush="{DynamicResource Linkast.BorderStrong}"
                                        BorderThickness="1" Background="#FF05060E" Padding="1">
                                    <Grid DataContext="{Binding Webcam}">
                                        <views:SceneEditor Layers="{Binding Layers}" CanvasWidth="{Binding CanvasWidth}" CanvasHeight="{Binding CanvasHeight}"
                                                           BasePlacement="{Binding BasePlacement}" BaseFit="{Binding BaseFit}"
                                                           BackgroundSource="{Binding EditorBackground}" MaxHeight="340" IsPreviewOnly="True"
                                                           OverlayItems="{Binding DataContext.Overlays.PreviewItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Output preview" />
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,8,0,0"
                                           Text="What viewers see. The screen picture here refreshes every 2 seconds; the stream itself runs at full frame rate." />
                            </StackPanel>
                        </Border>

                        <!-- Settings, one short tab each instead of one long page. -->
                        <ListBox x:Name="StreamTabs" Style="{StaticResource Linkast.Segmented}" HorizontalAlignment="Left" Margin="0,2,0,12"
                                 SelectedIndex="0" AutomationProperties.Name="Stream settings">
                            <ListBoxItem x:Name="TabSource" Padding="14,6" Content="Source &amp; audio" />
                            <ListBoxItem x:Name="TabDestination" Padding="14,6" Content="Destination" />
                            <ListBoxItem x:Name="TabNetwork" Padding="14,6" Content="Network" />
                            <ListBoxItem x:Name="TabQuality" Padding="14,6" Content="Quality" />
                            <ListBoxItem x:Name="TabOverlays" Padding="14,6" Content="Overlays" />
                        </ListBox>

                        <!-- ===== Source & audio ===== -->
                        <StackPanel Visibility="{Binding IsSelected, ElementName=TabSource, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Linkast.Card}" IsEnabled="{Binding CanEditSettings}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Command="{Binding RefreshSourcesCommand}"
                                                ToolTip="Reload displays, windows and audio devices">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                                                <AccessText Text="_Refresh" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="Capture" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Video source" Style="{StaticResource Linkast.Text.FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SelectedSourceKind}"
                                                      AutomationProperties.Name="Capture source type" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding IsDisplaySource, Converter={StaticResource BoolToVis}}">
                                            <Label Content="_Display" Target="{Binding ElementName=MonitorBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,0,0,5" />
                                            <ComboBox x:Name="MonitorBox" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding IsWindowSource, Converter={StaticResource BoolToVis}}">
                                            <Label Content="_Window" Target="{Binding ElementName=WindowBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,0,0,5" />
                                            <ComboBox x:Name="WindowBox" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Linkast.Text.Hint}" Foreground="{DynamicResource Linkast.Warning}" Margin="0,8,0,0"
                                               Visibility="{Binding IsWindowSource, Converter={StaticResource BoolToVis}}"
                                               Text="Games in exclusive fullscreen can capture as black. Use borderless or windowed mode, or capture the entire display." />
                                    <Expander Header="Advanced capture" Margin="0,12,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <CheckBox Content="Use Desktop Duplication instead of Windows Graphics Capture (displays only)"
                                                      IsChecked="{Binding UseDesktopDuplication}" IsEnabled="{Binding IsDisplaySource}" />
                                            <CheckBox Content="Capture the mouse cursor" IsChecked="{Binding CaptureCursor}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Audio: devices are fixed while live; volume, mute and noise removal change the stream instantly. -->
                            <Border Style="{StaticResource Linkast.Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Linkast.Text.Hint}" Margin="0" VerticalAlignment="Center"
                                                   Text="Volume, mute and noise removal work while live" />
                                        <TextBlock Text="Audio" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <CheckBox Content="System au_dio (what you hear)" IsChecked="{Binding SystemAudioEnabled}" FontWeight="SemiBold"
                                                      IsEnabled="{Binding CanEditSettings}" />
                                            <StackPanel IsEnabled="{Binding SystemAudioEnabled}" Margin="0,8,0,0">
                                                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                                          IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="System audio device" />
                                                <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding SystemAudioLevel, Mode=OneWay}"
                                                             Foreground="{DynamicResource Linkast.Success}" AutomationProperties.Name="System audio level" />
                                                <DockPanel Margin="0,10,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Icon}" Content="&#xE72C;" Width="26" Height="26" FontSize="12"
                                                            Click="OnResetSystemVolume" ToolTip="Reset to 100%" AutomationProperties.Name="Reset system audio volume" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SystemAudioVolume, StringFormat={}{0:0}%}" Width="44" TextAlignment="Right"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                    <Slider Minimum="0" Maximum="200" Value="{Binding SystemAudioVolume}" VerticalAlignment="Center"
                                                            AutomationProperties.Name="System audio volume" ToolTip="Volume (100% = unchanged)" />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Linkast.ToggleButton.Secondary}" MinHeight="28" Padding="10,3"
                                                              IsChecked="{Binding MicrophoneMuted}" IsEnabled="{Binding MicrophoneEnabled}"
                                                              ToolTip="Mute the microphone in the stream (works while live)" AutomationProperties.Name="Mute microphone">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE74F;" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding MicrophoneMuted, Converter={x:Static vm:Converters.MuteLabel}}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <CheckBox Content="_Microphone" IsChecked="{Binding MicrophoneEnabled}" FontWeight="SemiBold" IsEnabled="{Binding CanEditSettings}" />
                                            </DockPanel>
                                            <StackPanel IsEnabled="{Binding MicrophoneEnabled}" Margin="0,8,0,0">
                                                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                                                          IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="Microphone device" />
                                                <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding MicrophoneLevel, Mode=OneWay}"
                                                             Foreground="{DynamicResource Linkast.Success}" AutomationProperties.Name="Microphone level" />
                                                <DockPanel Margin="0,10,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Icon}" Content="&#xE72C;" Width="26" Height="26" FontSize="12"
                                                            Click="OnResetMicrophoneVolume" ToolTip="Reset to 100%" AutomationProperties.Name="Reset microphone volume" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MicrophoneVolume, StringFormat={}{0:0}%}" Width="44" TextAlignment="Right"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                    <Slider Minimum="0" Maximum="200" Value="{Binding MicrophoneVolume}" VerticalAlignment="Center"
                                                            AutomationProperties.Name="Microphone volume" ToolTip="Volume (100% = unchanged)" />
                                                </DockPanel>
                                                <CheckBox Content="Remove background _noise (fans, hum)" IsChecked="{Binding MicrophoneNoiseSuppression}" Margin="0,8,0,0"
                                                          ToolTip="Filters steady noise out of your microphone on this PC. Can be switched while live." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,10,0,0"
                                               Text="The microphone also drives voice-reactive camera effects. It is only measured while it is switched on." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Destination ===== -->
                        <Border Style="{StaticResource Linkast.Card}" IsEnabled="{Binding CanEditSettings}"
                                Visibility="{Binding IsSelected, ElementName=TabDestination, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE72E;" FontSize="11" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource Linkast.TextTertiary}" />
                                        <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0" Text="Key is masked and never logged" />
                                    </StackPanel>
                                    <TextBlock Text="Where to stream" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                </DockPanel>
                                <ListBox Style="{StaticResource Linkast.Segmented}" ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}"
                                         DisplayMemberPath="Name" AutomationProperties.Name="Platform" />

                                <!-- A preset: the server is filled in, the user only needs the key. -->
                                <StackPanel Visibility="{Binding IsCustomPlatform, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" Margin="0,10,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Command="{Binding OpenStreamKeyPageCommand}"
                                                ToolTip="Opens your platform's stream settings in your browser">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE8A7;" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="Where do I find my key?" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource Linkast.Text.Hint}" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis">
                                            <Run Text="Server:" /> <Run Text="{Binding ServerUrl, Mode=OneWay}" FontFamily="{DynamicResource Linkast.Font.Mono}" />
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Custom: any RTMP or RTMPS server, direct or through a restream service. -->
                                <StackPanel Visibility="{Binding IsCustomPlatform, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <ListBox Style="{StaticResource Linkast.Segmented}" ItemsSource="{Binding DestinationKinds}"
                                             SelectedItem="{Binding SelectedDestinationKind}" AutomationProperties.Name="Delivery type" />
                                    <TextBlock Style="{StaticResource Linkast.Text.Hint}" Text="{Binding SelectedDestinationKind.Explanation}" Margin="0,6,0,0" />
                                    <Label Content="Server _URL" Target="{Binding ElementName=ServerUrlBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,12,0,5" />
                                    <TextBox x:Name="ServerUrlBox" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.HelpText="For example rtmp://live.twitch.tv/app or rtmps://a.rtmps.youtube.com/live2" />
                                    <TextBlock Style="{StaticResource Linkast.Text.Hint}" Text="For example rtmp://live.twitch.tv/app or rtmps://a.rtmps.youtube.com/live2" />
                                </StackPanel>

                                <Label Content="Stream _key" Target="{Binding ElementName=StreamKeyBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,14,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="StreamKeyBox" PasswordChanged="OnStreamKeyChanged" AutomationProperties.Name="Stream key" />
                                    <TextBox x:Name="StreamKeyPlain" Visibility="Collapsed" TextChanged="OnStreamKeyPlainChanged"
                                             AutomationProperties.Name="Stream key (visible)" />
                                    <ToggleButton x:Name="ShowKeyToggle" Grid.Column="1" Style="{StaticResource Linkast.ToggleButton.Secondary}" Content="Show"
                                                  Margin="8,0,0,0" MinWidth="64" Checked="OnShowKeyChanged" Unchecked="OnShowKeyChanged"
                                                  AutomationProperties.Name="Show stream key" />
                                </Grid>
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}"
                                           Text="Saved encrypted for your Windows account only. Clear the field to forget it." />
                            </StackPanel>
                        </Border>

                        <!-- ===== Network: the feature that sets Linkast apart, so it gets the accent card. ===== -->
                        <Border Style="{StaticResource Linkast.Card.Feature}" IsEnabled="{Binding CanEditSettings}"
                                Visibility="{Binding IsSelected, ElementName=TabNetwork, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Command="{Binding RefreshNetworksCommand}"
                                            ToolTip="Look for network connections again">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Refresh" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Network for your stream" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,0,0,12"
                                           Text="Only Linkast's stream uses the network you pick. Your game and other apps keep Windows' normal connection. Linkast never switches networks on its own and never changes Windows settings." />
                                <ListBox x:Name="NetworkBox" Style="{StaticResource Linkast.Choice}" ItemsSource="{Binding NetworkOptions}"
                                         SelectedItem="{Binding SelectedNetwork}" AutomationProperties.Name="Network for your stream">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NetworkOption}">
                                            <Grid AutomationProperties.Name="{Binding Label}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Linkast.Surface3}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                    <TextBlock Style="{StaticResource Linkast.Text.Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Linkast.Accent}"
                                                               Text="{Binding Converter={x:Static vm:Converters.NetworkGlyph}}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Linkast.Text.Hint}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Linkast.Button.Primary}" Command="{Binding TestConnectionCommand}" VerticalAlignment="Top"
                                            ToolTip="Connects to your server through this network and shows which network was really used. Sends no video.">
                                        <AccessText Text="Test _connection" />
                                    </Button>
                                    <TextBlock Text="{Binding NetworkTestText}" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding NetworkTestOk, Converter={x:Static vm:Converters.TestResultBrush}}"
                                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Connection test result" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== Quality ===== -->
                        <Border Style="{StaticResource Linkast.Card}" IsEnabled="{Binding CanEditSettings}"
                                Visibility="{Binding IsSelected, ElementName=TabQuality, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Quality" Style="{StaticResource Linkast.Card.Title}" />
                                <!-- Auto setup: measures this PC and the upload, then suggests one setup to apply. -->
                                <Border Background="{DynamicResource Linkast.Surface2}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Primary}" Command="{Binding FindBestSettingsCommand}"
                                                    VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Find the best settings">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE9D9;" FontSize="13" Margin="0,0,8,0" />
                                                    <TextBlock Text="Find the best settings" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="Not sure what to pick?" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Text="Linkast tests the encoders on this PC and your upload, then suggests resolution, frame rate and bitrate. It takes about half a minute." />
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- Upload speed: measured on Twitch (test mode), typed in for other platforms. -->
                                        <DockPanel Margin="0,10,0,0" Visibility="{Binding CanMeasureUpload, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                            <TextBlock Text="Your upload speed (Mbps)" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Width="90" Text="{Binding UploadSpeedMbps, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Your upload speed in megabits per second" />
                                            <Button Style="{StaticResource Linkast.Button.Subtle}" Command="{Binding OpenSpeedTestCommand}" Margin="8,0,0,0" HorizontalAlignment="Left"
                                                    Content="Measure it in your browser" ToolTip="Opens speed.cloudflare.com. Use the Upload number." />
                                        </DockPanel>
                                        <TextBlock Text="{Binding AutoQualityStatus}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   Visibility="{Binding AutoQualityStatus, Converter={x:Static vm:Converters.NotNullToVisibility}}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <DockPanel Margin="0,10,0,0" Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Primary}" Command="{Binding ApplyRecommendationCommand}"
                                                    Content="Apply" Margin="12,0,0,0" MinWidth="90" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Suggested" Style="{StaticResource Linkast.Text.FieldLabel}" />
                                                <TextBlock Text="{Binding RecommendationText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="_Encoder" Target="{Binding ElementName=EncoderBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="EncoderBox" ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Re_solution" Target="{Binding ElementName=ResolutionBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="ResolutionBox" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <Label Content="_Frame rate" Target="{Binding ElementName=FpsBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="FpsBox" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SelectedFrameRate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <Label Content="_Bitrate (kbps)" Target="{Binding ElementName=BitrateBox}" Style="{StaticResource Linkast.Label.Field}" Margin="0,0,0,5" />
                                        <TextBox x:Name="BitrateBox" Text="{Binding VideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}" Text="{Binding EncoderNote}" />
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}"
                                           Text="Twitch recommends up to 6000 kbps. Your upload speed should be at least 1.5 times the bitrate." />
                                <TextBlock Text="Recording" Style="{StaticResource Linkast.Text.FieldLabel}" Margin="0,16,0,5" />
                                <CheckBox Content="Also record when I go live" IsChecked="{Binding RecordWhenLive}"
                                          ToolTip="Saves every stream to a file on this PC as well. It uses the same encoding, so it costs almost nothing extra." />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Secondary}" Content="Open" Margin="8,0,0,0"
                                            Command="{Binding OpenRecordingFolderCommand}" ToolTip="Open the recordings folder" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Secondary}" Content="Change…" Margin="8,0,0,0"
                                            Command="{Binding ChooseRecordingFolderCommand}" ToolTip="Choose where recordings are saved" />
                                    <TextBox Text="{Binding RecordingFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Recordings folder" />
                                </DockPanel>
                                <CheckBox Content="Make an MP4 copy when a recording ends" IsChecked="{Binding RemuxRecordingsToMp4}" Margin="0,8,0,0"
                                          ToolTip="Recordings are saved as MKV, which survives a crash or power cut. MP4 plays in more editors and phones; the copy is quick and keeps the quality." />
                                <Expander Header="Advanced encoding" Margin="0,12,0,0">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Label Content="Keyframe interval (s)" Target="{Binding ElementName=KeyframeBox}" Style="{StaticResource Linkast.Label.Field}" />
                                            <TextBox x:Name="KeyframeBox" Text="{Binding KeyframeIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="Audio bitrate (kbps)" Target="{Binding ElementName=AudioBitrateBox}" Style="{StaticResource Linkast.Label.Field}" />
                                            <TextBox x:Name="AudioBitrateBox" Text="{Binding AudioBitrateKbps, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <Label Content="Encoder preset" Target="{Binding ElementName=PresetBox}" Style="{StaticResource Linkast.Label.Field}" />
                                            <TextBox x:Name="PresetBox" Text="{Binding EncoderPreset, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Leave empty for the default (p5 for NVENC, veryfast for x264)." />
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ===== Overlays: pictures on top of the stream, and the Be right back screen ===== -->
                        <StackPanel DataContext="{Binding Overlays}">
                            <StackPanel Visibility="{Binding IsSelected, ElementName=TabOverlays, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Linkast.Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Primary}" Command="{Binding AddWebCommand}" Margin="8,0,0,0" AutomationProperties.Name="Add alerts or web page"
                                                    ToolTip="Paste the overlay link from Reymit, Streamlabs, StreamElements or another alert service (up to 3 overlays)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE774;" FontSize="12" Margin="0,0,8,0" />
                                                    <AccessText Text="Add _alerts or web page" />
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Primary}" Command="{Binding AddImageCommand}" AutomationProperties.Name="Add picture"
                                                    ToolTip="Add a logo or another picture on top of your stream (up to 3 overlays)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                                    <AccessText Text="Add _picture" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Overlays" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,0,0,12"
                                                   Text="Alerts, a chat box or a logo on top of your stream. Showing, hiding, moving and resizing work while live." />

                                        <Border Background="{DynamicResource Linkast.Surface2}" CornerRadius="{StaticResource Linkast.Radius.Action}" Padding="16,14"
                                                Visibility="{Binding HasItems, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Linkast.Text.Body}" TextAlignment="Center"
                                                       Text="No overlays yet. Add your alerts link from your donation or alert service, or a picture such as your logo." />
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:OverlayItemViewModel}">
                                                    <Border Background="{DynamicResource Linkast.Surface2}" BorderBrush="{DynamicResource Linkast.BorderSubtle}" BorderThickness="1"
                                                            CornerRadius="{StaticResource Linkast.Radius.Action}" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="14" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="96" Height="54" CornerRadius="6" VerticalAlignment="Top" ClipToBounds="True"
                                                                    Background="{DynamicResource Linkast.Surface3}">
                                                                <Grid>
                                                                    <Image Source="{Binding Bitmap}" Stretch="Uniform" Margin="4" />
                                                                    <TextBlock Text="Missing file" FontSize="10" Foreground="{DynamicResource Linkast.Warning}" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="2">
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Icon}" Content="&#xE74D;" Foreground="{DynamicResource Linkast.Live}"
                                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                            ToolTip="Remove this overlay" AutomationProperties.Name="Remove overlay" />
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Content="Change picture" MinHeight="30" Padding="10,4"
                                                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                                                            Command="{Binding DataContext.ChangeImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                                    <CheckBox DockPanel.Dock="Right" Content="Show" IsChecked="{Binding Visible}" Margin="0,0,10,0" MinWidth="0" VerticalAlignment="Center" />
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="40" Margin="0,0,10,0" AutomationProperties.Name="Overlay name" />
                                                                </DockPanel>

                                                                <!-- Web overlay: the link is entered once and then hidden, because the
                                                                     Linkast window is often on stream and the link holds an account token. -->
                                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsWeb, Converter={StaticResource BoolToVis}}">
                                                                    <DockPanel Visibility="{Binding IsEditingUrl, Converter={StaticResource BoolToVis}}">
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Primary}" Content="Save link" Command="{Binding SaveUrlCommand}"
                                                                                Margin="8,0,0,0" />
                                                                        <TextBox Text="{Binding UrlDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Overlay link"
                                                                                 ToolTip="The overlay or alert box link from your alert service, starting with https://" />
                                                                    </DockPanel>
                                                                    <DockPanel Visibility="{Binding IsEditingUrl, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Command="{Binding ReloadCommand}" MinHeight="30" Padding="10,4"
                                                                                ToolTip="Load the page again, for example after changing your alert design">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                                                                <TextBlock Text="Reload" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Linkast.Button.Subtle}" Content="Change link" Command="{Binding ChangeUrlCommand}"
                                                                                MinHeight="30" Padding="10,4" />
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE72E;" FontSize="12" Margin="0,0,6,0"
                                                                                       Foreground="{DynamicResource Linkast.Success}" />
                                                                            <TextBlock Text="Link saved and hidden" Foreground="{DynamicResource Linkast.TextSecondary}" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource Linkast.Warning}" Margin="0,6,0,0"
                                                                               Visibility="{Binding Problem, Converter={x:Static vm:Converters.NotNullToVisibility}}" />
                                                                </StackPanel>
                                                                <Grid Margin="0,8,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="14" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Position" Style="{StaticResource Linkast.Text.FieldLabel}" />
                                                                        <ComboBox ItemsSource="{Binding DataContext.Positions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                  SelectedItem="{Binding Position}" AutomationProperties.Name="Overlay position">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={x:Static vm:Converters.EnumLabel}}" />
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                    <views:ValueSlider Grid.Column="2" Label="Size" Value="{Binding Size}" Minimum="0.05" Maximum="1" Format="{}{0:0%}"
                                                                                       IsEnabled="{Binding IsSizeAdjustable}" Margin="0,-6,0,0" ToolTip="Width compared with the stream" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,4,0,0" Visibility="{Binding HasWebItems, Converter={StaticResource BoolToVis}}"
                                                   Text="Alert sounds reach your stream through System audio (Source &amp; audio tab), like in OBS." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Linkast.Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Linkast.ToggleButton.Secondary}" IsChecked="{Binding IsAway}"
                                                          ToolTip="Cover the stream now (works while live)" AutomationProperties.Name="Show Be right back screen">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE769;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding IsAway, Converter={x:Static vm:Converters.AwayLabel}}" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <TextBlock Text="Be right back screen" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,0,0,12"
                                                   Text="Covers the game, cameras and overlays without stopping the stream. Use it for breaks, or before you start as a Starting soon screen." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top" BorderBrush="{DynamicResource Linkast.BorderStrong}" BorderThickness="1">
                                                <Image Source="{Binding AwayThumbnail}" Stretch="Uniform" AutomationProperties.Name="Be right back screen preview" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Title" Style="{StaticResource Linkast.Text.FieldLabel}" />
                                                <TextBox Text="{Binding AwayTitle, UpdateSourceTrigger=PropertyChanged, Delay=300}" MaxLength="60" AutomationProperties.Name="Be right back title" />
                                                <TextBlock Text="Message" Style="{StaticResource Linkast.Text.FieldLabel}" Margin="0,10,0,5" />
                                                <TextBox Text="{Binding AwaySubtitle, UpdateSourceTrigger=PropertyChanged, Delay=300}" MaxLength="100" AutomationProperties.Name="Be right back message" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding ChooseAwayImageCommand}" Margin="0,0,8,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xEB9F;" FontSize="13" Margin="0,0,8,0" />
                                                            <TextBlock Text="Use my own picture…" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource Linkast.Button.Subtle}" Content="Use the Linkast card" Command="{Binding UseAwayCardCommand}" Margin="0,0,8,6"
                                                            Visibility="{Binding HasAwayImage, Converter={StaticResource BoolToVis}}" />
                                                </WrapPanel>
                                                <CheckBox Content="Also mute game and PC sound while away (your microphone stays on)" IsChecked="{Binding AwayMuteSystemAudio}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Status column ===== -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,18,22,22">
                        <Border Style="{StaticResource Linkast.Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right" Style="{Binding State, Converter={x:Static vm:Converters.StateToPillStyle}}">
                                        <TextBlock Text="{Binding PillText}" />
                                    </Border>
                                    <TextBlock Text="Stream status" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource Linkast.Text.Timer}"
                                               VerticalAlignment="Top" Margin="10,0,0,0" AutomationProperties.Name="Elapsed time" />
                                    <TextBlock Style="{StaticResource Linkast.Text.StatusTitle}" AutomationProperties.LiveSetting="Assertive"
                                               Text="{Binding StatusTitleText}" />
                                </DockPanel>
                                <!-- One action slot: Go live while stopped, End stream while running. -->
                                <Button Style="{StaticResource Linkast.Button.GoLive}" Command="{Binding StartCommand}" ToolTip="Start streaming (Ctrl+Enter)"
                                        Visibility="{Binding IsBroadcasting, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE768;" FontSize="18" Margin="0,0,10,0" />
                                        <AccessText Text="_Go live" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Linkast.Button.Destructive}" Command="{Binding StopCommand}" MinHeight="48"
                                        FontSize="{StaticResource Linkast.FontSize.Action}" FontFamily="{DynamicResource Linkast.Font.Display}" FontWeight="Bold"
                                        Visibility="{Binding IsBroadcasting, Converter={StaticResource BoolToVis}}" ToolTip="Stop streaming">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE71A;" FontSize="16" Margin="0,0,10,0" />
                                        <AccessText Text="_End stream" />
                                    </StackPanel>
                                </Button>
                                <!-- Record to a file without going live (Go live records too when "Also record" is on). -->
                                <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding ToggleRecordingCommand}" Margin="0,8,0,0"
                                        Visibility="{Binding IsBroadcasting, Converter={x:Static vm:Converters.InverseBoolToVisibility}}"
                                        ToolTip="Save to a file on this PC without going live. To record your streams, turn on 'Also record when I go live' on the Quality tab."
                                        AutomationProperties.Name="{Binding RecordButtonText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE7C8;" FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Linkast.Error}" />
                                        <TextBlock Text="{Binding RecordButtonText}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}" Text="{Binding ReadinessText}" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}" Text="{Binding LastRecordingText}" Margin="0,2,0,0"
                                           Visibility="{Binding LastRecordingText, Converter={x:Static vm:Converters.NotNullToVisibility}}" />
                                <!-- Quick actions: both work instantly while live and before going live. -->
                                <UniformGrid Columns="2" Margin="0,12,-8,0">
                                    <ToggleButton Style="{StaticResource Linkast.ToggleButton.Secondary}" Margin="0,0,8,0" IsChecked="{Binding MicrophoneMuted}"
                                                  IsEnabled="{Binding MicrophoneEnabled}" ToolTip="Mute the microphone in the stream" AutomationProperties.Name="Mute microphone">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE74F;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding MicrophoneMuted, Converter={x:Static vm:Converters.MuteLabel}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource Linkast.ToggleButton.Secondary}" Margin="0,0,8,0" IsChecked="{Binding Overlays.IsAway}"
                                                  ToolTip="Cover the stream with the Be right back screen without stopping it" AutomationProperties.Name="Be right back">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE769;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Be right back" />
                                        </StackPanel>
                                    </ToggleButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Linkast.Issue.Warning}"
                                Visibility="{Binding WarningText, Converter={x:Static vm:Converters.NotNullToVisibility}}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Linkast.Warning}"
                                           VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Linkast.Issue.Error}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.LiveSetting="Assertive">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE783;" Foreground="{DynamicResource Linkast.Error}" Margin="0,0,8,0" />
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding LastError.Category, Mode=OneWay, Converter={x:Static vm:Converters.ErrorCategoryLabel}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LastError.UserMessage}" TextWrapping="Wrap" />
                                <Button Style="{StaticResource Linkast.Button.Primary}" Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Visibility="{Binding LastError.Category, Converter={x:Static vm:Converters.NetworkErrorToVisibility}}" Content="Test connection" />
                                <Expander Header="Technical details" Margin="0,8,0,0"
                                          Visibility="{Binding LastError.Detail, Converter={x:Static vm:Converters.NotNullToVisibility}}">
                                    <TextBox Text="{Binding LastError.Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11"
                                             FontFamily="{DynamicResource Linkast.Font.Mono}" BorderThickness="0" Background="Transparent"
                                             AutomationProperties.Name="Technical details" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Linkast.Card}">
                            <StackPanel>
                                <TextBlock Text="Stream health" Style="{StaticResource Linkast.Card.Title}" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource Linkast.Text.Hint}" Text="Measured on the real connection" Margin="0,0,0,12" />

                                <!-- Before going live: what will be sent, instead of a grid of dashes. -->
                                <StackPanel Visibility="{Binding IsActive, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Linkast.Text.Hint}" Margin="0,0,0,8" Text="Live numbers appear here when you go live." />
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Output" Foreground="{DynamicResource Linkast.TextTertiary}" Width="70" />
                                        <TextBlock TextAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding SelectedResolution.Height, Mode=OneWay, StringFormat={}{0}p}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding SelectedFrameRate, Mode=OneWay, StringFormat={}{0} FPS}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding VideoBitrateKbps, Mode=OneWay, StringFormat={}{0} kbps}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Encoder" Foreground="{DynamicResource Linkast.TextTertiary}" Width="70" />
                                        <TextBlock Text="{Binding SelectedEncoder.DisplayName}" TextAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Network" Foreground="{DynamicResource Linkast.TextTertiary}" Width="70" />
                                        <TextBlock Text="{Binding SelectedNetwork.Name}" TextAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedNetwork.Label}" />
                                    </DockPanel>
                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0,0,-8,-8" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource Linkast.MetricTile}">
                                        <StackPanel>
                                            <TextBlock Text="Frame rate" Style="{StaticResource Linkast.MetricTile.Label}" />
                                            <TextBlock Text="{Binding FpsText}" Style="{StaticResource Linkast.MetricTile.Value}" />
                                            <TextBlock Text="encoded / target" Style="{StaticResource Linkast.MetricTile.Caption}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Linkast.MetricTile}">
                                        <StackPanel>
                                            <TextBlock Text="Upload" Style="{StaticResource Linkast.MetricTile.Label}" />
                                            <TextBlock Text="{Binding UploadText}" Style="{StaticResource Linkast.MetricTile.Value}" />
                                            <TextBlock Text="measured on socket" Style="{StaticResource Linkast.MetricTile.Caption}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Linkast.MetricTile}">
                                        <StackPanel>
                                            <TextBlock Text="Encoder speed" Style="{StaticResource Linkast.MetricTile.Label}" />
                                            <TextBlock Text="{Binding EncoderText}" Style="{StaticResource Linkast.MetricTile.Value}" />
                                            <TextBlock Text="1× = real time" Style="{StaticResource Linkast.MetricTile.Caption}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Linkast.MetricTile}">
                                        <StackPanel>
                                            <TextBlock Text="Dropped / dup." Style="{StaticResource Linkast.MetricTile.Label}" />
                                            <TextBlock Text="{Binding DroppedText}" Style="{StaticResource Linkast.MetricTile.Value}" />
                                            <TextBlock Text="frames" Style="{StaticResource Linkast.MetricTile.Caption}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Linkast.MetricTile}">
                                        <StackPanel>
                                            <TextBlock Text="Reconnects" Style="{StaticResource Linkast.MetricTile.Label}" />
                                            <TextBlock Text="{Binding ReconnectsText}" Style="{StaticResource Linkast.MetricTile.Value}" />
                                            <TextBlock Text="this stream" Style="{StaticResource Linkast.MetricTile.Caption}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Linkast.MetricTile}" ToolTip="{Binding InterfaceText}">
                                        <StackPanel>
                                            <TextBlock Text="Network used" Style="{StaticResource Linkast.MetricTile.Label}" />
                                            <TextBlock Text="{Binding InterfaceText}" Style="{StaticResource Linkast.MetricTile.Value}" FontSize="14" />
                                            <TextBlock Text="verified on socket" Style="{StaticResource Linkast.MetricTile.Caption}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Linkast.Card}">
                            <StackPanel>
                                <DockPanel>
                                    <ToggleButton x:Name="LogToggle" DockPanel.Dock="Right" Style="{StaticResource Linkast.ToggleButton.Subtle}" Checked="OnLogToggled"
                                                  Unchecked="OnLogToggled" Content="Show log" AutomationProperties.Name="Show activity log" />
                                    <TextBlock Text="Activity" Style="{StaticResource Linkast.Card.Title}" Margin="0" />
                                </DockPanel>
                                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="{DynamicResource Linkast.Font.Mono}" FontSize="11"
                                         MaxHeight="260" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}"
                                         AutomationProperties.Name="Activity log">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="4,1" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Foreground" Value="{DynamicResource Linkast.TextSecondary}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,0"
                                            ToolTip="Copies a report without your stream key, for bug reports">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Copy diagnostics" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Linkast.Button.Secondary}" Command="{Binding OpenLogFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Linkast.Text.Glyph}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Open logs" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource Linkast.Button.Subtle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="OnOpenSettings" ToolTip="Updates and appearance" Padding="4,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateText}" FontSize="11"
                                           Foreground="{Binding UpdateAvailable, Converter={x:Static vm:Converters.UpdateBrush}}"
                                           FontWeight="{Binding UpdateAvailable, Converter={x:Static vm:Converters.BoldWhenTrue}}" />
                                <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource Linkast.TextTertiary}" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Webcam Studio ===== -->
            <ScrollViewer x:Name="WebcamPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=NavWebcam, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="22,18,22,22" MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Text="Webcam Studio" Style="{StaticResource Linkast.Text.PageTitle}" />
                    <TextBlock Text="Shape your cameras, add effects and place them on your stream." Style="{StaticResource Linkast.Text.Hint}"
                               FontSize="12" Margin="0,2,0,16" />
                    <views:WebcamPanel x:Name="Studio" DataContext="{Binding Webcam}" />
                </StackPanel>
            </ScrollViewer>

            <views:SettingsPage Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}" />
            <views:AboutPage Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>

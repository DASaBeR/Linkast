<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Linkast Dark colour tokens, generated by tools/theme/gen-tokens.sh: edit colors.txt there, not this file.
       Tokens.Dark.xaml and Tokens.Light.xaml have identical keys; ThemeService
       swaps one for the other. Reference these with DynamicResource so a theme change applies live. -->

  <Color x:Key="Linkast.AppBgColor">#FF0B0D1B</Color>
  <Color x:Key="Linkast.Surface1Color">#FF11142A</Color>
  <Color x:Key="Linkast.Surface2Color">#FF171B35</Color>
  <Color x:Key="Linkast.Surface3Color">#FF202646</Color>
  <Color x:Key="Linkast.SurfaceHoverColor">#FF252B4B</Color>
  <Color x:Key="Linkast.BorderSubtleColor">#FF2A3154</Color>
  <Color x:Key="Linkast.BorderStrongColor">#FF3B4771</Color>
  <Color x:Key="Linkast.TextPrimaryColor">#FFF4F6FF</Color>
  <Color x:Key="Linkast.TextSecondaryColor">#FFB5BCD9</Color>
  <Color x:Key="Linkast.TextTertiaryColor">#FF8993B8</Color>
  <Color x:Key="Linkast.AccentColor">#FF6B8EFF</Color>
  <Color x:Key="Linkast.AccentHoverColor">#FF84A1FF</Color>
  <Color x:Key="Linkast.AccentPressedColor">#FF5B82FF</Color>
  <Color x:Key="Linkast.AccentSoftColor">#296B8EFF</Color>
  <Color x:Key="Linkast.OnAccentColor">#FF0B0D1B</Color>
  <Color x:Key="Linkast.OnBrandColor">#FFFFFFFF</Color>
  <Color x:Key="Linkast.FocusColor">#FF18D2FF</Color>
  <Color x:Key="Linkast.StateOverlayColor">#FFFFFFFF</Color>
  <Color x:Key="Linkast.BrandCyanColor">#FF18D2FF</Color>
  <Color x:Key="Linkast.BrandBlueColor">#FF2F6BFF</Color>
  <Color x:Key="Linkast.BrandVioletColor">#FFA24CFF</Color>
  <Color x:Key="Linkast.BrandNavyTopColor">#FF1D1B48</Color>
  <Color x:Key="Linkast.BrandNavyBottomColor">#FF090A1C</Color>
  <Color x:Key="Linkast.LiveColor">#FFFF5964</Color>
  <Color x:Key="Linkast.LiveSoftColor">#29FF5964</Color>
  <Color x:Key="Linkast.WarningColor">#FFFFC15A</Color>
  <Color x:Key="Linkast.WarningSoftColor">#29FFC15A</Color>
  <Color x:Key="Linkast.SuccessColor">#FF48D597</Color>
  <Color x:Key="Linkast.SuccessSoftColor">#2948D597</Color>
  <Color x:Key="Linkast.ErrorColor">#FFFF765E</Color>
  <Color x:Key="Linkast.ErrorSoftColor">#29FF765E</Color>
  <Color x:Key="Linkast.IdleColor">#FF9299B3</Color>
  <Color x:Key="Linkast.IdleSoftColor">#299299B3</Color>
  <Color x:Key="Linkast.ShadowColor">#59000000</Color>

  <SolidColorBrush x:Key="Linkast.AppBg" Color="{StaticResource Linkast.AppBgColor}"/>
  <SolidColorBrush x:Key="Linkast.Surface1" Color="{StaticResource Linkast.Surface1Color}"/>
  <SolidColorBrush x:Key="Linkast.Surface2" Color="{StaticResource Linkast.Surface2Color}"/>
  <SolidColorBrush x:Key="Linkast.Surface3" Color="{StaticResource Linkast.Surface3Color}"/>
  <SolidColorBrush x:Key="Linkast.SurfaceHover" Color="{StaticResource Linkast.SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="Linkast.BorderSubtle" Color="{StaticResource Linkast.BorderSubtleColor}"/>
  <SolidColorBrush x:Key="Linkast.BorderStrong" Color="{StaticResource Linkast.BorderStrongColor}"/>
  <SolidColorBrush x:Key="Linkast.TextPrimary" Color="{StaticResource Linkast.TextPrimaryColor}"/>
  <SolidColorBrush x:Key="Linkast.TextSecondary" Color="{StaticResource Linkast.TextSecondaryColor}"/>
  <SolidColorBrush x:Key="Linkast.TextTertiary" Color="{StaticResource Linkast.TextTertiaryColor}"/>
  <SolidColorBrush x:Key="Linkast.Accent" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="Linkast.AccentHover" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="Linkast.AccentPressed" Color="{StaticResource Linkast.AccentPressedColor}"/>
  <SolidColorBrush x:Key="Linkast.AccentSoft" Color="{StaticResource Linkast.AccentSoftColor}"/>
  <SolidColorBrush x:Key="Linkast.OnAccent" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="Linkast.OnBrand" Color="{StaticResource Linkast.OnBrandColor}"/>
  <SolidColorBrush x:Key="Linkast.Focus" Color="{StaticResource Linkast.FocusColor}"/>
  <SolidColorBrush x:Key="Linkast.StateOverlay" Color="{StaticResource Linkast.StateOverlayColor}"/>
  <SolidColorBrush x:Key="Linkast.BrandCyan" Color="{StaticResource Linkast.BrandCyanColor}"/>
  <SolidColorBrush x:Key="Linkast.BrandBlue" Color="{StaticResource Linkast.BrandBlueColor}"/>
  <SolidColorBrush x:Key="Linkast.BrandViolet" Color="{StaticResource Linkast.BrandVioletColor}"/>
  <SolidColorBrush x:Key="Linkast.BrandNavyTop" Color="{StaticResource Linkast.BrandNavyTopColor}"/>
  <SolidColorBrush x:Key="Linkast.BrandNavyBottom" Color="{StaticResource Linkast.BrandNavyBottomColor}"/>
  <SolidColorBrush x:Key="Linkast.Live" Color="{StaticResource Linkast.LiveColor}"/>
  <SolidColorBrush x:Key="Linkast.LiveSoft" Color="{StaticResource Linkast.LiveSoftColor}"/>
  <SolidColorBrush x:Key="Linkast.Warning" Color="{StaticResource Linkast.WarningColor}"/>
  <SolidColorBrush x:Key="Linkast.WarningSoft" Color="{StaticResource Linkast.WarningSoftColor}"/>
  <SolidColorBrush x:Key="Linkast.Success" Color="{StaticResource Linkast.SuccessColor}"/>
  <SolidColorBrush x:Key="Linkast.SuccessSoft" Color="{StaticResource Linkast.SuccessSoftColor}"/>
  <SolidColorBrush x:Key="Linkast.Error" Color="{StaticResource Linkast.ErrorColor}"/>
  <SolidColorBrush x:Key="Linkast.ErrorSoft" Color="{StaticResource Linkast.ErrorSoftColor}"/>
  <SolidColorBrush x:Key="Linkast.Idle" Color="{StaticResource Linkast.IdleColor}"/>
  <SolidColorBrush x:Key="Linkast.IdleSoft" Color="{StaticResource Linkast.IdleSoftColor}"/>
  <SolidColorBrush x:Key="Linkast.Shadow" Color="{StaticResource Linkast.ShadowColor}"/>

  <LinearGradientBrush x:Key="Linkast.BrandGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Linkast.BrandCyanColor}" Offset="0"/>
    <GradientStop Color="{StaticResource Linkast.BrandBlueColor}" Offset="0.52"/>
    <GradientStop Color="{StaticResource Linkast.BrandVioletColor}" Offset="1"/>
  </LinearGradientBrush>
  <!-- Go live button: the same three stops, left to right. -->
  <LinearGradientBrush x:Key="Linkast.GoLiveGradient" StartPoint="0,0.3" EndPoint="1,0.7">
    <GradientStop Color="{StaticResource Linkast.BrandCyanColor}" Offset="0"/>
    <GradientStop Color="{StaticResource Linkast.BrandBlueColor}" Offset="0.52"/>
    <GradientStop Color="{StaticResource Linkast.BrandVioletColor}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Linkast.NavMarkerGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource Linkast.BrandCyanColor}" Offset="0"/>
    <GradientStop Color="{StaticResource Linkast.BrandBlueColor}" Offset="0.5"/>
    <GradientStop Color="{StaticResource Linkast.BrandVioletColor}" Offset="1"/>
  </LinearGradientBrush>

  <!-- Fluent bridge: the stock Fluent controls (ComboBox, CheckBox, Slider, TextBox, ListBox…) read these keys.
       Pointing them at Linkast tokens gives those controls the brand accent and the navy-tinted text colours
       instead of the Windows accent. Fluent's translucent control fills then tint themselves from AppBg. -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Linkast.AppBgColor}"/>
  <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource Linkast.AppBgColor}"/>
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Linkast.TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Linkast.TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Linkast.TextTertiaryColor}"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Linkast.AccentPressedColor}"/>
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource Linkast.AccentPressedColor}"/>
  <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource Linkast.AccentPressedColor}"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPointerOver" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPressed" Color="{StaticResource Linkast.AccentPressedColor}"/>
  <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedStrokePressed" Color="{StaticResource Linkast.AccentPressedColor}"/>
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource Linkast.AccentHoverColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{StaticResource Linkast.OnAccentColor}"/>
  <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource Linkast.AccentColor}"/>
  <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{StaticResource Linkast.AccentSoftColor}"/>
  <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="{StaticResource Linkast.AccentSoftColor}"/>
  <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="{StaticResource Linkast.AccentSoftColor}"/>
  <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressedThemeBrush" Color="{StaticResource Linkast.AccentSoftColor}"/>
  <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource Linkast.TextPrimaryColor}"/>

  <!-- Fluent geometry: the stock controls get Linkast corner radii (5 px controls so check boxes stay square,
       8 px drop-down buttons, 10 px pop-ups)
       and the same 34 px height as Linkast buttons. -->
  <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
  <CornerRadius x:Key="ComboBoxDropDownButtonBackgroundCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">10</CornerRadius>
  <sys:Double x:Key="TextControlThemeMinHeight">34</sys:Double>
</ResourceDictionary>

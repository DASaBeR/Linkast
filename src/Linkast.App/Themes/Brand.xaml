<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Linkast mark: an "L" whose stem is shared with a "k" (arm and leg), filled with the brand
        gradient from cyan through blue to violet. This file is the single source of the logo:
        the app uses these resources directly, and tools/make-icon.ps1 renders the .ico and PNGs
        from them. Geometry is in a 242 x 190 design box.
    -->

    <Color x:Key="BrandCyan">#FF18D2FF</Color>
    <Color x:Key="BrandBlue">#FF2F6BFF</Color>
    <Color x:Key="BrandViolet">#FFA24CFF</Color>
    <Color x:Key="BrandNavyTop">#FF1D1B48</Color>
    <Color x:Key="BrandNavyBottom">#FF090A1C</Color>

    <!-- Absolute coordinates so all three shapes share one continuous gradient across the mark. -->
    <LinearGradientBrush x:Key="BrandGradient" MappingMode="Absolute" StartPoint="0,0" EndPoint="242,190">
        <GradientStop Color="{StaticResource BrandCyan}" Offset="0.05" />
        <GradientStop Color="{StaticResource BrandBlue}" Offset="0.5" />
        <GradientStop Color="{StaticResource BrandViolet}" Offset="0.95" />
    </LinearGradientBrush>

    <!-- L with the shared stem; the top of the stem is cut at a slight angle, the corner is rounded. -->
    <Geometry x:Key="BrandGeometryL">M 0,10 L 46,2 L 46,147 L 120,147 L 120,190 L 40,190 A 40,40 0 0 1 0,150 Z</Geometry>
    <!-- Upper arm of the k: rises from the L's inner corner. -->
    <Geometry x:Key="BrandGeometryArm">M 46,147 L 92,147 L 200,35 L 154,35 Z</Geometry>
    <!-- Leg of the k: starts under the arm, ends at the baseline with a rounded end. -->
    <Geometry x:Key="BrandGeometryLeg">M 118,120 L 150,87 L 220,157 A 23,23 0 0 1 188,190 Z</Geometry>

    <DrawingGroup x:Key="BrandMarkDrawing">
        <GeometryDrawing Brush="{StaticResource BrandGradient}" Geometry="{StaticResource BrandGeometryL}" />
        <GeometryDrawing Brush="{StaticResource BrandGradient}" Geometry="{StaticResource BrandGeometryArm}" />
        <GeometryDrawing Brush="{StaticResource BrandGradient}" Geometry="{StaticResource BrandGeometryLeg}" />
    </DrawingGroup>

    <!-- The mark alone (transparent background). -->
    <DrawingImage x:Key="BrandMark" Drawing="{StaticResource BrandMarkDrawing}" />

    <!-- App icon: the mark on a deep navy rounded square (300 x 300 design box). -->
    <DrawingImage x:Key="BrandAppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 H 300 V 300 H 0 Z" Brush="Transparent" />
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                            <GradientStop Color="{StaticResource BrandNavyTop}" Offset="0" />
                            <GradientStop Color="{StaticResource BrandNavyBottom}" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,6,288,288" RadiusX="66" RadiusY="66" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Same shapes as BrandMarkDrawing (a drawing can't have two parents; geometries can be shared). -->
                <DrawingGroup Transform="0.86,0,0,0.86,46,68">
                    <GeometryDrawing Brush="{StaticResource BrandGradient}" Geometry="{StaticResource BrandGeometryL}" />
                    <GeometryDrawing Brush="{StaticResource BrandGradient}" Geometry="{StaticResource BrandGeometryArm}" />
                    <GeometryDrawing Brush="{StaticResource BrandGradient}" Geometry="{StaticResource BrandGeometryLeg}" />
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandCyan}" Offset="0" />
        <GradientStop Color="{StaticResource BrandBlue}" Offset="0.5" />
        <GradientStop Color="{StaticResource BrandViolet}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>

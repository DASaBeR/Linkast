root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xaml,csproj,props,targets,manifest,xml,slnx}]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true
file_header_template = SPDX-License-Identifier: GPL-3.0-or-later

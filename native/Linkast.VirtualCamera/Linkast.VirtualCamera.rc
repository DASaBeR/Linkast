#include "resource.h"
#include <winver.h>

// 1280 x 720 "Linkast is not running" picture, rendered from the brand artwork by tools/make-icon.ps1.
IDR_PLACEHOLDER PNG "placeholder.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Linkast contributors"
            VALUE "FileDescription", "Linkast Camera (virtual camera media source)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Copyright (C) Linkast contributors. GPL-3.0-or-later."
            VALUE "ProductName", "Linkast"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
